{
  "name": "@finnberry/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "node scripts/prisma-env.mjs db push && pnpm run db:rls",
    "db:rls": "node scripts/prisma-env.mjs db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "db:migrate": "node scripts/prisma-env.mjs migrate dev",
    "db:studio": "node scripts/prisma-env.mjs studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.2.0",
    "typescript": "^5.7.0"
  }
}
